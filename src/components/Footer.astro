---
// Kontaktopplysningene hentes fra samme fil som /kontakt bruker, slik at et bytte
// av telefonnummer i CMS-et slår gjennom både her og der. Sto de to stedene hver
// for seg, ville bunnteksten på hver eneste side blitt stående med gamle tall.
import { frontmatter as kontakt } from '../content/sider/kontakt.md';
import { telefonlenke } from '../lib/format';

const aar = new Date().getFullYear();
const personer = (kontakt.personer ?? []).filter((p: any) => p.telefon || p.epost);
---
<footer class="bunn">
  <div class="wrap">
    <div class="bunn-grid">
      <div>
        <h4>Heart of Gold</h4>
        <p>Frivillig forening i Eidskog. Vi samler inn penger gjennom konserter, quizkvelder og dugnad, og gir alt videre. Gjør verden bedre for noen — siden 2001.</p>
      </div>
      <div>
        <h4>Kontakt</h4>
        <p>
          {kontakt.epost && <><a href={`mailto:${kontakt.epost}`}>{kontakt.epost}</a><br /></>}
          {personer.map((p: any) => (
            <>
              {p.navn} · {p.telefon
                ? <a href={`tel:${telefonlenke(p.telefon)}`}>{p.telefon}</a>
                : <a href={`mailto:${p.epost}`}>{p.epost}</a>}
              <br />
            </>
          ))}
        </p>
      </div>
      <div>
        <h4>Mer</h4>
        <p>
          {kontakt.facebook && <><a href={kontakt.facebook} rel="noopener">Facebook</a><br /></>}
          <a href="/nepal/">Arbeidet i Nepal</a><br>
          <a href="/gode-hjelpere/">Gode hjelpere</a><br>
          <a href="/robert">Til minne om Robert</a><br>
          <a href="/vedtekter">Vedtekter</a><br>
          <a href="/stott-oss">Støtt oss</a><br>
          <a href="/rss.xml">RSS</a>
        </p>
      </div>
    </div>
    <div class="bunn-linje">
      <span>© {aar} Heart of Gold</span>
      <span>«Å gjøre verden bedre for noen»</span>
    </div>
  </div>
</footer>
