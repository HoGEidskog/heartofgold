---
/**
 * Bildekavalkade for 25-årsjubileet.
 *
 * Slås av med "jubileum": false i src/data/nettsted.json. Da forsvinner hele
 * seksjonen, og JavaScript-en under lastes ikke.
 *
 * Sveipingen er ren CSS (scroll-snap), så den virker uten JavaScript på
 * berøringsskjerm. Skriptet legger til det mus og tastatur trenger: piler,
 * dra-med-musen, piltaster og automatisk bytte.
 */
export type Bilde = { fil: string; tekst: string; aar: string | null };
const { bilder = [], tittel, ingress } = Astro.props as {
  bilder: Bilde[];
  tittel: string;
  ingress: string;
};
---
{bilder.length > 0 && (
  <section class="jubileum">
    <div class="wrap">
      <div class="topp">
        <div>
          <span class="merkelapp">Jubileum</span>
          <h2>{tittel}</h2>
          <p class="ingress">{ingress}</p>
        </div>
        <div class="styring" data-styring hidden>
          <button class="rund" type="button" data-forrige aria-label="Forrige bilde">
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
              <path d="M12.5 4 6.5 10l6 6" fill="none" stroke="currentColor" stroke-width="2.2"
                    stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button class="rund" type="button" data-neste aria-label="Neste bilde">
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
              <path d="M7.5 4 13.5 10l-6 6" fill="none" stroke="currentColor" stroke-width="2.2"
                    stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button class="pause" type="button" data-pause aria-pressed="false">
            <span data-pause-tekst>Pause</span>
          </button>
        </div>
      </div>
    </div>

    <div
      class="spor"
      data-kavalkade
      tabindex="0"
      role="region"
      aria-roledescription="bildekavalkade"
      aria-label={tittel}
    >
      {bilder.map((b, i) => (
        <figure class="bilde" data-lysbilde>
          <img src={b.fil} alt={b.tekst} loading={i < 2 ? 'eager' : 'lazy'} draggable="false" />
          <figcaption>
            {b.aar && <span class="ar">{b.aar}</span>}
            {b.tekst}
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
)}

<style>
  .jubileum{padding:clamp(48px,7vw,76px) 0;
    background:linear-gradient(180deg,var(--tak),#fff);}
  .topp{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;flex-wrap:wrap;
    margin-bottom:28px;}
  .jubileum h2{margin-top:16px;}
  .ingress{color:var(--blekk-mykt);max-width:52ch;margin-top:14px;}

  .styring{display:flex;gap:8px;align-items:center;flex:none;}
  .rund{width:44px;height:44px;border-radius:999px;border:1px solid var(--kant);background:#fff;
    display:grid;place-items:center;cursor:pointer;color:var(--indigo);padding:0;}
  .rund:hover{border-color:var(--indigo);}
  .rund:disabled{opacity:.35;cursor:default;}
  .rund:disabled:hover{border-color:var(--kant);}
  .pause{border:1px solid var(--kant);background:#fff;border-radius:999px;
    padding:12px 20px;font:inherit;font-weight:700;font-size:14px;cursor:pointer;
    color:var(--indigo);}
  .pause:hover{border-color:var(--indigo);}

  /* Negative marger lar raden gå helt ut til skjermkanten. Den scroller
     internt og gir derfor ingen overflyt på siden. */
  .spor{display:flex;gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;
    padding:4px 24px 18px;scrollbar-width:none;-webkit-overflow-scrolling:touch;
    scroll-behavior:smooth;}
  .spor::-webkit-scrollbar{display:none;}
  .spor:focus-visible{outline:3px solid var(--indigo);outline-offset:-3px;border-radius:8px;}
  /* Mens man drar med musen skal ikke snap-punktene kjempe imot */
  .spor.drar{scroll-snap-type:none;scroll-behavior:auto;cursor:grabbing;}
  .spor.drar img{pointer-events:none;}

  .bilde{flex:none;width:min(78vw,420px);margin:0;scroll-snap-align:center;}
  .bilde img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:var(--radius);
    background:var(--tak);display:block;user-select:none;}
  .bilde figcaption{margin-top:12px;font-size:15px;color:var(--blekk-mykt);}
  .ar{display:inline-block;font-family:var(--display);font-weight:800;font-size:13px;
    color:var(--indigo);background:var(--tak);padding:3px 10px;border-radius:999px;
    margin-right:8px;font-variant-numeric:tabular-nums;}

  @media (prefers-reduced-motion:reduce){
    .spor{scroll-behavior:auto;}
  }
</style>

<script>
  const spor = document.querySelector<HTMLElement>('[data-kavalkade]');
  const styring = document.querySelector<HTMLElement>('[data-styring]');
  const knapp = document.querySelector<HTMLButtonElement>('[data-pause]');
  const knappTekst = document.querySelector<HTMLElement>('[data-pause-tekst]');
  const forrigeKn = document.querySelector<HTMLButtonElement>('[data-forrige]');
  const nesteKn = document.querySelector<HTMLButtonElement>('[data-neste]');

  if (spor && styring && knapp && knappTekst && forrigeKn && nesteKn) {
    // Knappene er skjult i markupen, så de ikke står døde uten JavaScript
    styring.hidden = false;

    const roligere = window.matchMedia('(prefers-reduced-motion: reduce)');
    const INTERVALL = 5000;
    let timer: number | undefined;
    // Har brukeren bedt om mindre bevegelse, starter vi i pause – men de kan
    // overstyre det med play-knappen. Det er valget deres å ta.
    let pauset = roligere.matches;

    const steg = () => {
      const f = spor.querySelector<HTMLElement>('[data-lysbilde]');
      return f ? f.offsetWidth + 18 : 300;
    };
    const maks = () => spor.scrollWidth - spor.clientWidth;

    const gaa = (retning: 1 | -1) => {
      const naa = spor.scrollLeft;
      let mal = naa + retning * steg();
      if (mal > maks() - 4) mal = retning === 1 ? 0 : maks();   // rundt på slutten
      if (mal < 0) mal = maks();
      spor.scrollTo({ left: mal, behavior: roligere.matches ? 'auto' : 'smooth' });
    };

    const stopp = () => { if (timer) { clearInterval(timer); timer = undefined; } };
    const start = () => {
      stopp();
      if (!pauset && !document.hidden) timer = window.setInterval(() => gaa(1), INTERVALL);
    };

    const oppdaterKnapp = () => {
      knapp.setAttribute('aria-pressed', String(pauset));
      knappTekst.textContent = pauset ? 'Spill av' : 'Pause';
    };

    knapp.addEventListener('click', () => { pauset = !pauset; oppdaterKnapp(); start(); });
    // Blar man selv, skal den ikke rykke videre rett etterpå
    forrigeKn.addEventListener('click', () => { stopp(); gaa(-1); start(); });
    nesteKn.addEventListener('click', () => { stopp(); gaa(1); start(); });

    // Piltaster når kavalkaden har fokus
    spor.addEventListener('keydown', e => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      stopp();
      gaa(e.key === 'ArrowRight' ? 1 : -1);
      start();
    });

    // Dra med musen. En scroll-container lar seg ikke dra av seg selv, og på
    // PC finnes det ingen sveip – uten dette er piler og hjul eneste vei.
    let drar = false, startX = 0, startScroll = 0, harFlyttet = false;
    spor.addEventListener('pointerdown', e => {
      if (e.pointerType === 'touch') return;   // berøring håndteres av nettleseren
      drar = true; harFlyttet = false;
      startX = e.clientX;
      startScroll = spor.scrollLeft;
      spor.classList.add('drar');
      spor.setPointerCapture(e.pointerId);
      stopp();
    });
    spor.addEventListener('pointermove', e => {
      if (!drar) return;
      const avstand = e.clientX - startX;
      if (Math.abs(avstand) > 3) harFlyttet = true;
      spor.scrollLeft = startScroll - avstand;
    });
    const slipp = (e: PointerEvent) => {
      if (!drar) return;
      drar = false;
      spor.classList.remove('drar');
      try { spor.releasePointerCapture(e.pointerId); } catch {}
      start();
    };
    spor.addEventListener('pointerup', slipp);
    spor.addEventListener('pointercancel', slipp);
    // Et drag skal ikke ende i at man følger en lenke eller markerer tekst
    spor.addEventListener('click', e => { if (harFlyttet) { e.preventDefault(); e.stopPropagation(); } }, true);
    spor.addEventListener('dragstart', e => e.preventDefault());

    // Berøringssveip og hjul: la nettleseren gjøre jobben, men ta pause imens
    spor.addEventListener('touchstart', stopp, { passive: true });
    spor.addEventListener('touchend', start, { passive: true });
    spor.addEventListener('wheel', () => { stopp(); start(); }, { passive: true });

    // Stå stille mens noen leser
    spor.addEventListener('mouseenter', stopp);
    spor.addEventListener('mouseleave', () => { if (!drar) start(); });
    spor.addEventListener('focusin', stopp);
    spor.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', start);
    roligere.addEventListener('change', () => { pauset = roligere.matches; oppdaterKnapp(); start(); });

    oppdaterKnapp();
    start();
  }
</script>
