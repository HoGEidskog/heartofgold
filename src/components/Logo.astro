---
/**
 * Foreningens logo: hjertet i fargesprut, hentet fra Facebook-siden.
 *
 * Bildet har gjennomsiktig bakgrunn, og hjertekonturene og teksten er
 * utsparinger – slik logoen er tegnet. Den forutsetter derfor lys bakgrunn.
 * Kilden er 343 px bred; byttes ut når originalfilen i høyere oppløsning
 * kommer fra foreningen.
 */
const { size = 30 } = Astro.props;
// Logoen er litt bredere enn høy (343 x 328)
const bredde = Math.round(size * (343 / 328));
---
<img
  src="/bilder/logo-hjerte.png"
  width={bredde}
  height={size}
  alt=""
  aria-hidden="true"
  decoding="async"
/>
