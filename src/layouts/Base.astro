---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props { tittel: string; beskrivelse?: string; bilde?: string; }
const { tittel, beskrivelse = 'Heart of Gold er en frivillig forening i Eidskog som samler inn penger til gode formål gjennom konserter, quizkvelder og dugnad. Motto: å gjøre verden bedre for noen.', bilde } = Astro.props;
const fullTittel = tittel === 'Heart of Gold' ? tittel : `${tittel} – Heart of Gold`;
const kanonisk = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="nb">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTittel}</title>
  <meta name="description" content={beskrivelse}>
  <link rel="canonical" href={kanonisk}>
  <meta property="og:site_name" content="Heart of Gold">
  <meta property="og:title" content={fullTittel}>
  <meta property="og:description" content={beskrivelse}>
  <meta property="og:type" content="website">
  <meta property="og:locale" content="nb_NO">
  {bilde && <meta property="og:image" content={new URL(bilde, Astro.site)} />}
  <meta name="theme-color" content="#E8437F">
  <link rel="icon" href="/favicon.png" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="alternate" type="application/rss+xml" title="Heart of Gold" href="/rss.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Figtree:wght@400;500;600;700&display=swap">
</head>
<body>
  <Header />
  <main id="innhold">
    <slot />
  </main>
  <Footer />
</body>
</html>
