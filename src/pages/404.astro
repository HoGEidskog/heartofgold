---
import Base from '../layouts/Base.astro';
---
<Base tittel="Siden finnes ikke">
  <section>
    <div class="wrap" style="text-align:center;padding:40px 0;">
      <h1>Her var det tomt</h1>
      <p class="undertekst" style="margin-left:auto;margin-right:auto;">Siden du lette etter finnes ikke lenger. Prøv forsiden, eller se hva vi har gjort gjennom årene.</p>
      <p style="margin-top:28px;display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
        <a class="kn kn-p" href="/">Til forsiden</a>
        <a class="kn kn-s" href="/prosjekter">Prosjekter</a>
      </p>
    </div>
  </section>
</Base>
