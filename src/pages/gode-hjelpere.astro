---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const hjelpere = (await getCollection('hjelpere')).sort((a, b) => {
  if (a.data.rekkefolge !== b.data.rekkefolge) return a.data.rekkefolge - b.data.rekkefolge;
  return a.data.navn.localeCompare(b.data.navn, 'nb');
});

const rendret = await Promise.all(
  hjelpere.map(async h => ({ h, Innhold: (await render(h)).Content })),
);

---
<Base
  tittel="Gode hjelpere"
  beskrivelse="Bedriftene og folkene som har stilt opp for Heart of Gold gjennom årene."
>
  <section>
    <div class="wrap">
      <div class="tittelblokk">
        <span class="merkelapp">Takk</span>
        <h1>Gode hjelpere</h1>
        <p class="undertekst">
          Ingen av arrangementene våre hadde gått uten folk som stiller opp. Noen låner
          oss lokalet, noen gir premier, noen lager mat, noen gir av sitt eget overskudd.
          Alt sammen gjør at inngangspengene kan gå uavkortet videre.
        </p>
      </div>

      <div class="hjelpere">
        {rendret.map(({ h, Innhold }) => (
          <article class="kort">
            <div class="merke">
              {h.data.logo
                ? <img src={h.data.logo} alt={h.data.navn} loading="lazy" />
                : <span class="navnemerke">{h.data.navn}</span>}
            </div>

            <div class="innhold">
              <h2>
                {h.data.lenke
                  ? <a href={h.data.lenke} rel="noopener">{h.data.navn}</a>
                  : h.data.navn}
              </h2>

              <div class="tekst"><Innhold /></div>

              {h.data.bilde && (
                <figure>
                  <img src={h.data.bilde} alt={h.data.bildetekst ?? ''} loading="lazy" />
                  {h.data.bildetekst && <figcaption>{h.data.bildetekst}</figcaption>}
                </figure>
              )}
            </div>
          </article>
        ))}
      </div>

      <div class="ogsaa">
        <h2>Og alle de andre</h2>

        <p>
          Musikerne som har spilt gratis siden 2001, de som har bakt, båret stoler,
          solgt lodd og vasket opp etterpå. Navnene på musikerne står under hvert
          <a href="/prosjekter/">arrangement</a>. Resten er for mange til å telle,
          men ikke til å glemme.
        </p>

        <p>
          Og alle som gir. Noen kjøper billett de ikke rekker å bruke, noen runder
          godt opp i døra, noen sender en sum på Vipps uten å være i nærheten av
          lokalet. Det er ofte disse bidragene som gjør at et arrangement går fra å
          dekke kostnadene til å bety noe.
        </p>

        <p>
          Vi navngir dem ikke – de aller fleste vil helst være i fred. Men
          givergleden i bygda er stor, og den skal ikke stå unevnt.
        </p>

        <div class="videre">
          <a class="kn kn-p" href="/stott-oss/">Slik kan du bidra</a>
          <p>
            Vil bedriften din stille opp? <a href="/kontakt/">Ta kontakt</a> – det
            trenger ikke være penger.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hjelpere{display:grid;gap:22px;}
  .kort{display:grid;grid-template-columns:200px minmax(0,1fr);gap:28px;
    border:1px solid var(--kant);border-radius:var(--radius);padding:26px;align-items:start;}

  /* Uten logo står navnet som et tekstmerke. Da ser kortet like ferdig ut. */
  .merke{display:grid;place-items:center;min-height:110px;background:var(--tak);
    border-radius:14px;padding:18px;}
  /* Logoene er klippet fra en plakat og har hvit bakgrunn. Hvit flate rundt dem
     gjør at de ikke står som en boks oppå den grå. */
  .merke:has(img){background:#fff;border:1px solid var(--kant);}
  .merke img{max-width:100%;max-height:90px;width:auto;object-fit:contain;}
  .navnemerke{font-family:var(--display);font-weight:800;font-size:19px;line-height:1.2;
    text-align:center;color:var(--blekk-mykt);}

  .kort h2{font-size:clamp(20px,2.4vw,25px);}
  .kort h2 a{color:inherit;text-decoration:none;border-bottom:2px solid var(--kant);}
  .kort h2 a:hover{border-bottom-color:var(--magenta);}

  .tekst{margin-top:14px;color:var(--blekk-mykt);max-width:62ch;}
  .tekst :global(p){margin-bottom:.7em;}

  .kort figure{margin:16px 0 0;}
  .kort figure img{width:100%;max-width:520px;border-radius:14px;}
  .kort figcaption{margin-top:8px;font-size:14px;color:var(--blekk-mykt);}

  /* Egen blokk, ikke en fotnote. De aller fleste bidragene kommer herfra, og
     de skal ikke stå med liten skrift nederst. */
  .ogsaa{margin-top:44px;background:var(--tak);border-radius:var(--radius-stor);
    padding:clamp(30px,4vw,44px);}
  .ogsaa h2{font-size:clamp(24px,3.4vw,32px);margin-bottom:18px;}
  .ogsaa p{color:var(--blekk-mykt);max-width:62ch;}
  /* :not(.kn) – ellers arver knappen lenkefargen og blir blå på magenta */
  .ogsaa a:not(.kn){color:var(--indigo);font-weight:600;}

  .videre{margin-top:26px;padding-top:24px;border-top:1px solid var(--kant);
    display:flex;flex-wrap:wrap;align-items:center;gap:18px;}
  .videre p{margin:0;font-size:15px;}

  @media (max-width:700px){
    .kort{grid-template-columns:1fr;gap:18px;}
    .merke{min-height:90px;max-width:200px;}
  }
</style>
