---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const BIDRAG: Record<string, string> = {
  lokale: 'Lokale',
  premier: 'Premier',
  servering: 'Servering',
  varer: 'Varer og samarbeid',
};

const prosjekter = await getCollection('prosjekter');

const hjelpere = (await getCollection('hjelpere')).sort((a, b) => {
  if (a.data.rekkefolge !== b.data.rekkefolge) return a.data.rekkefolge - b.data.rekkefolge;
  return a.data.navn.localeCompare(b.data.navn, 'nb');
});

// Hvor mange arrangementer hver har bidratt til, og hvilke år. Regnes ut fra
// koblingene i prosjektene, så tallene kan ikke komme i utakt med innholdet.
const medTall = await Promise.all(
  hjelpere.map(async h => {
    const mine = prosjekter
      .filter(p => p.data.hjelpere.includes(h.id))
      .sort((a, b) => b.data.aar - a.data.aar);
    const aar = [...new Set(mine.map(p => p.data.aar))].sort((a, b) => b - a);
    return { h, Innhold: (await render(h)).Content, antall: mine.length, aar };
  }),
);

const antallHjelpere = hjelpere.length;
---
<Base
  tittel="Gode hjelpere"
  beskrivelse="Bedriftene og folkene som har stilt opp med lokale, premier og servering gjennom årene."
>
  <section>
    <div class="wrap">
      <div class="tittelblokk">
        <span class="merkelapp">Takk</span>
        <h1>Gode hjelpere</h1>
        <p class="undertekst">
          Ingen av arrangementene våre hadde gått uten folk som stiller opp. Noen låner
          oss lokalet, noen gir premier, noen lager mat. Alt sammen gratis, og alt sammen
          gjør at inngangspengene kan gå uavkortet videre.
        </p>
      </div>

      <div class="hjelpere">
        {medTall.map(({ h, Innhold, antall, aar }) => (
          <article class="kort">
            <div class="merke">
              {h.data.logo
                ? <img src={h.data.logo} alt={h.data.navn} loading="lazy" />
                : <span class="navnemerke">{h.data.navn}</span>}
            </div>

            <div class="innhold">
              <h2>
                {h.data.lenke
                  ? <a href={h.data.lenke} rel="noopener">{h.data.navn}</a>
                  : h.data.navn}
              </h2>

              {h.data.bidrag.length > 0 && (
                <ul class="merkelapper">
                  {h.data.bidrag.map(b => <li>{BIDRAG[b] ?? b}</li>)}
                </ul>
              )}

              <div class="tekst"><Innhold /></div>

              {antall > 0 && (
                <p class="teller">
                  Har bidratt ved {antall} {antall === 1 ? 'arrangement' : 'arrangementer'}
                  <span class="aar"> · {aar.join(', ')}</span>
                </p>
              )}

              {h.data.bilde && (
                <figure>
                  <img src={h.data.bilde} alt={h.data.bildetekst ?? ''} loading="lazy" />
                  {h.data.bildetekst && <figcaption>{h.data.bildetekst}</figcaption>}
                </figure>
              )}
            </div>
          </article>
        ))}
      </div>

      <div class="ogsaa">
        <h2>Og alle de andre</h2>
        <p>
          Musikerne som har spilt gratis siden 2001, de som har bakt, båret stoler,
          solgt lodd og vasket opp etterpå. Navnene på musikerne står under hvert
          <a href="/prosjekter/"> arrangement</a>. Resten er for mange til å telle,
          men ikke til å glemme.
        </p>
        <p class="kontakt-lenke">
          Vil bedriften din bidra? <a href="/kontakt/">Ta kontakt</a> – det trenger
          ikke være penger.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .hjelpere{display:grid;gap:22px;}
  .kort{display:grid;grid-template-columns:200px minmax(0,1fr);gap:28px;
    border:1px solid var(--kant);border-radius:var(--radius);padding:26px;align-items:start;}

  /* Uten logo står navnet som et tekstmerke. Da ser kortet like ferdig ut. */
  .merke{display:grid;place-items:center;min-height:110px;background:var(--tak);
    border-radius:14px;padding:18px;}
  .merke img{max-width:100%;max-height:90px;width:auto;object-fit:contain;}
  .navnemerke{font-family:var(--display);font-weight:800;font-size:19px;line-height:1.2;
    text-align:center;color:var(--blekk-mykt);}

  .kort h2{font-size:clamp(20px,2.4vw,25px);}
  .kort h2 a{color:inherit;text-decoration:none;border-bottom:2px solid var(--kant);}
  .kort h2 a:hover{border-bottom-color:var(--magenta);}

  .merkelapper{display:flex;flex-wrap:wrap;gap:8px;list-style:none;margin:12px 0 0;padding:0;}
  .merkelapper li{font-size:13px;font-weight:600;padding:4px 12px;border-radius:999px;
    background:rgba(31,123,153,.14);color:#0E5C7A;}

  .tekst{margin-top:14px;color:var(--blekk-mykt);max-width:62ch;}
  .tekst :global(p){margin-bottom:.7em;}

  .teller{margin:14px 0 0;font-size:14.5px;color:var(--blekk-mykt);}
  .teller .aar{font-variant-numeric:tabular-nums;}

  .kort figure{margin:16px 0 0;}
  .kort figure img{width:100%;max-width:520px;border-radius:14px;}
  .kort figcaption{margin-top:8px;font-size:14px;color:var(--blekk-mykt);}

  .ogsaa{margin-top:40px;padding-top:30px;border-top:1px solid var(--kant);max-width:66ch;}
  .ogsaa h2{font-size:clamp(22px,3vw,28px);margin-bottom:14px;}
  .ogsaa p{color:var(--blekk-mykt);}
  .ogsaa a{color:var(--indigo);font-weight:600;}
  .kontakt-lenke{margin-top:16px;}

  @media (max-width:700px){
    .kort{grid-template-columns:1fr;gap:18px;}
    .merke{min-height:90px;max-width:200px;}
  }
</style>
