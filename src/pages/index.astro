---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { kr, dato } from '../lib/format';
import { AKTIVITETER } from '../lib/aktiviteter';
import Jubileum from '../components/Jubileum.astro';
import arkiv from '../data/arkivbilder.json';
import nettsted from '../data/nettsted.json';

const prosjekter = (await getCollection('prosjekter')).sort((a, b) => b.data.aar - a.data.aar);
const totalt = prosjekter.reduce((s, p) => s + (p.data.belop ?? 0), 0);
const antall = prosjekter.length;
const utfylte = prosjekter;
// Ett høydepunkt per år – det største beløpet – slik at forsiden viser bredden i arbeidet
const perAar = new Map<number, typeof utfylte[number]>();
for (const p of utfylte) {
  if (!p.data.belop) continue;
  const forrige = perAar.get(p.data.aar);
  if (!forrige || (forrige.data.belop ?? 0) < p.data.belop) perAar.set(p.data.aar, p);
}
const hoydepunkter = [...perAar.values()].sort((a, b) => b.data.aar - a.data.aar).slice(0, 6);

const nyheter = (await getCollection('nyheter'))
  .sort((a, b) => b.data.dato.valueOf() - a.data.dato.valueOf())
  .slice(0, 3);

// Bilder til jubileumskavalkaden: ett per prosjekt som har et, pluss arkivet.
// Eldst først, så den leses som en reise gjennom årene.
const jubileumsbilder = nettsted.jubileum
  ? (() => {
      const sett = new Set<string>();
      const ut: { fil: string; tekst: string; aar: string | null }[] = [];
      const fraProsjekter = [...prosjekter]
        .sort((a, b) => a.data.aar - b.data.aar)
        .filter(p => p.data.bilde)
        .map(p => ({ fil: p.data.bilde!, tekst: p.data.bildetekst || p.data.tittel, aar: String(p.data.aar) }));
      // Ikke alt tåler å vises stort. Logoer er avlange, og de eldste
      // Blogger-bildene er små nok til å bli grøt når de blåses opp.
      // Kravene lempes av seg selv når originalbildene kommer.
      const MIN_BREDDE = 400;
      const MAKS_FORHOLD = 2;
      const fraArkiv = ((arkiv.bilder ?? []) as any[])
        .filter(b => b.aar && !b.skjulIGalleri)
        .filter(b => {
          if (!b.bredde || !b.hoyde) return false;
          const forhold = b.bredde / b.hoyde;
          return b.bredde >= MIN_BREDDE && forhold <= MAKS_FORHOLD && forhold >= 1 / MAKS_FORHOLD;
        })
        .map(b => ({ fil: b.fil as string, tekst: b.tekst as string, aar: b.aar as string }));
      for (const b of [...fraProsjekter, ...fraArkiv].sort((a, b) => (a.aar ?? '').localeCompare(b.aar ?? ''))) {
        if (sett.has(b.fil)) continue;
        sett.add(b.fil);
        ut.push(b);
      }
      return ut;
    })()
  : [];

// Aktivitetstypene som faktisk er i bruk, med antall
const typer = AKTIVITETER
  .map(a => ({ ...a, antall: prosjekter.filter(p => p.data.type === a.verdi).length }))
  .filter(a => a.antall > 0);

// Nepal er det lengste engasjementet. Tallene regnes ut, ikke skrives inn.
const nepal = prosjekter.filter(p => p.data.serie === 'nepal');
const nepalSum = nepal.reduce((s, p) => s + (p.data.belop ?? 0), 0);
---
<Base tittel="Heart of Gold">
  <div class="hero">
    <div class="blob b1"></div><div class="blob b2"></div><div class="blob b3"></div>
    <div class="wrap hero-inner">
      <div>
        <span class="merkelapp">Frivillig forening i Eidskog · siden 2001</span>
        <h1>Å gjøre verden bedre for <span class="stripe">noen</span></h1>
        <p class="ingress">Konserter, quizkvelder og dugnad. Alt vi samler inn går rett videre til en hjertesak. Ingen sak er for liten, ingen er for stor.</p>
        <div class="hero-knapper">
          <a class="kn kn-p" href="/stott-oss">Støtt en hjertesak</a>
          <a class="kn kn-s" href="/prosjekter">Se hva vi har gjort</a>
        </div>
      </div>
      <div class="hjerte-boks">
        <img src="/bilder/logo-hjerte.png" width="339" height="322" alt="Heart of Gold" fetchpriority="high" />
      </div>
    </div>
  </div>

  {nettsted.jubileum && (
    <Jubileum
      bilder={jubileumsbilder}
      tittel={nettsted.jubileumstittel}
      ingress={nettsted.jubileumsingress}
    />
  )}

  <div class="tallrad">
    <div class="wrap tall-grid">
      <div class="tallkort"><b>{kr(totalt)}</b><span>gitt bort siden 2001</span></div>
      <div class="tallkort"><b>{antall}</b><span>tiltak gjennomført</span></div>
      <div class="tallkort"><b>100 %</b><span>går til formålet</span></div>
    </div>
  </div>

  <section>
    <div class="wrap">
      <div class="tittelblokk">
        <span class="merkelapp">Om foreningen</span>
        <h2>Gi videre, hver gang</h2>
        <p class="undertekst">Heart of Gold støtter gode formål og tiltak, fortrinnsvis med økonomiske bidrag. Inntektene skapes gjennom konserter, quizkvelder og dugnad, og overskuddet går i sin helhet til veldedige formål. Ingen sak er for liten, og ingen er for stor.</p>
      </div>
      <p class="minne-linje">Foreningen bærer samtidig minnet om <a href="/robert">Robert Rønhovde</a>, og støtter hvert år en hjertesak i hans navn.</p>

      <div class="aktiviteter">
        {typer.map(a => (
          <a class="akt" href={`/aktiviteter/${a.verdi}/`}>
            <b>{a.flertall}</b>
            <span class="antall">{a.antall}</span>
            <span class="ing">{a.ingress}</span>
          </a>
        ))}
      </div>

      <a class="lenke-videre" href="/aktiviteter/">Mer om hvordan vi samler inn →</a>
    </div>
  </section>

  {nepal.length > 0 && (
    <section class="nepal-blokk">
      <div class="wrap nepal-inner">
        <div>
          <span class="merkelapp">Hjertesak</span>
          <h2>Skolen og barnehjemmet i Nepal</h2>
          <p>
            Det lengste engasjementet vårt. Det begynte med et besøk i Katmandu i 2016,
            og har fortsatt siden. Heart of Gold-quizen er dedikert til dette formålet, og
            elevene ved Finnskogen Montessoriskole har samlet inn selv.
          </p>
          <p class="nepal-tall"><strong>{kr(nepalSum)}</strong> sendt så langt</p>
          <a class="lenke-videre" href="/nepal/">Les om arbeidet i Nepal →</a>
        </div>
        <div class="nepal-bilde">
          <img src="/bilder/2018-quizkveld.jpg" alt="Quizkveld til inntekt for Nepal" loading="lazy" />
        </div>
      </div>
    </section>
  )}

  <section>
    <div class="wrap">
      <div class="tittelblokk">
        <span class="merkelapp">Prosjekter</span>
        <h2>Hver krone videre</h2>
        <p class="undertekst">Et utvalg av tiltakene siden 2001. Alt vi har samlet inn er gitt videre.</p>
      </div>
      <div class="kortgrid">
        {hoydepunkter.map((p, i) => (
          <a class="pkort" href={`/prosjekter#${p.id}`}>
            <span class={`ar f${i % 5}`}>{p.data.aar}</span>
            <b>{p.data.tittel}</b>
            {p.data.mottaker && <small>{p.data.mottaker}</small>}
            <span class="sum">{kr(p.data.belop)}</span>
          </a>
        ))}
      </div>
      <a class="lenke-videre" href="/prosjekter">Alle prosjekter 2001–i dag →</a>
    </div>
  </section>

  {nyheter.length > 0 && (
    <section class="aktuelt-blokk">
      <div class="wrap">
        <div class="tittelblokk">
          <span class="merkelapp">Aktuelt</span>
          <h2>Det skjer nå</h2>
        </div>
        <div class="kortgrid">
          {nyheter.map(n => (
            <a class="kort" href={`/aktuelt/${n.id}`}>
              <div class="kort-bilde">{n.data.bilde && <img src={n.data.bilde} alt="" loading="lazy" />}</div>
              <div class="kort-tekst">
                <time datetime={n.data.dato.toISOString()}>{dato(n.data.dato)}</time>
                <h3>{n.data.tittel}</h3>
                {n.data.ingress && <p>{n.data.ingress}</p>}
              </div>
            </a>
          ))}
        </div>
        <a class="lenke-videre" href="/aktuelt">Alle nyheter →</a>
      </div>
    </section>
  )}

  <section>
    <div class="wrap">
      <div class="stotte-boks">
        <h2>Bli med å gi</h2>
        <p>Alt vi samler inn går uavkortet videre. Ingen i foreningen tar ut en krone.</p>
        <a class="kn kn-hvit" href="/stott-oss">Slik støtter du oss</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero{position:relative;overflow:hidden;padding:clamp(48px,7vw,78px) 0 clamp(52px,7vw,82px);}
  .blob{position:absolute;border-radius:50%;filter:blur(70px);opacity:.5;pointer-events:none;}
  .b1{width:520px;height:520px;background:var(--magenta);top:-190px;right:-100px;}
  .b2{width:430px;height:430px;background:var(--gul);top:60px;right:180px;opacity:.42;}
  .b3{width:400px;height:400px;background:var(--turkis);top:-120px;right:340px;opacity:.32;}
  .hero-inner{position:relative;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);
    gap:52px;align-items:center;}
  .hero h1{margin-top:18px;}
  /* Gul er utelatt her med vilje: den har for svak kontrast mot hvitt, og en
     overgang fra gul til cyan blander seg til grønt – en tone logoen ikke har. */
  .stripe{background:linear-gradient(100deg,var(--indigo),var(--magenta) 50%,var(--korall));
    -webkit-background-clip:text;background-clip:text;color:transparent;}
  .ingress{font-size:19px;color:var(--blekk-mykt);max-width:46ch;margin-top:22px;}
  .hero-knapper{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px;}
  .hjerte-boks{display:grid;place-items:center;}
  /* Kilden er 339 px bred, så vi viser den ikke større enn den er. Byttes ut
     når foreningen finner logoen i høyere oppløsning. */
  .hjerte-boks img{width:min(100%,339px);height:auto;}

  .tallrad{padding-bottom:12px;}
  .tall-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;}
  .tallkort{border-radius:var(--radius);padding:28px 26px;color:#fff;}
  .tallkort:nth-child(1){background:linear-gradient(140deg,var(--magenta),var(--korall));}
  .tallkort:nth-child(2){background:linear-gradient(140deg,var(--indigo),var(--turkis));}
  /* Gult kort får mørk tekst – gul bærer ikke hvit skrift */
  .tallkort:nth-child(3){background:linear-gradient(140deg,var(--gul),#FBE79A);color:var(--blekk);}
  .tallkort b{font-family:var(--display);font-weight:800;font-size:clamp(28px,4.6vw,44px);
    display:block;line-height:1.05;font-variant-numeric:tabular-nums;}
  .tallkort span{display:block;margin-top:9px;font-weight:600;font-size:14.5px;opacity:.93;}

  /* Minnet om Robert hører med i formålet, men skal ikke veie like tungt som
     arbeidet foreningen gjør. Derfor én dempet linje, ikke et eget kort. */
  .minne-linje{color:var(--blekk-mykt);font-size:15.5px;max-width:62ch;
    margin:0 0 30px;padding-left:16px;border-left:2px solid var(--kant);}
  .minne-linje a{color:var(--indigo);text-decoration:none;border-bottom:1px solid var(--kant);}
  .minne-linje a:hover{border-bottom-color:var(--indigo);}

  .aktiviteter{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));
    gap:14px;margin-top:30px;}
  .akt{border:1px solid var(--kant);border-radius:18px;padding:20px;text-decoration:none;
    color:inherit;display:flex;flex-direction:column;transition:border-color .18s ease;}
  .akt:hover{border-color:var(--magenta);}
  .akt b{font-family:var(--display);font-size:18px;font-weight:700;}
  .akt .antall{font-family:var(--display);font-weight:800;font-size:24px;line-height:1.1;
    margin-top:6px;font-variant-numeric:tabular-nums;
    background:linear-gradient(100deg,var(--magenta),var(--korall));
    -webkit-background-clip:text;background-clip:text;color:transparent;}
  .akt .ing{margin-top:8px;font-size:14.5px;color:var(--blekk-mykt);}

  .nepal-blokk{background:var(--tak);}
  .nepal-inner{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);
    gap:44px;align-items:center;padding-top:clamp(48px,7vw,76px);padding-bottom:clamp(48px,7vw,76px);}
  .nepal-blokk h2{margin-top:16px;}
  .nepal-blokk p{color:var(--blekk-mykt);max-width:56ch;margin-top:18px;}
  .nepal-tall{font-family:var(--display);font-size:19px;color:var(--blekk) !important;}
  .nepal-tall strong{font-weight:800;font-size:26px;font-variant-numeric:tabular-nums;
    background:linear-gradient(100deg,var(--magenta),var(--korall));
    -webkit-background-clip:text;background-clip:text;color:transparent;}
  .nepal-bilde img{width:100%;border-radius:var(--radius);max-height:380px;object-fit:cover;}

  .aktuelt-blokk{background:var(--tak);}

  .stotte-boks{background:linear-gradient(135deg,var(--magenta),var(--korall) 45%,var(--gul));
    border-radius:var(--radius-stor);padding:clamp(46px,6vw,64px) 30px;color:#fff;text-align:center;}
  .stotte-boks h2{color:#fff;}
  .stotte-boks p{max-width:48ch;margin:16px auto 28px;font-size:18px;color:rgba(255,255,255,.95);}

  @media (max-width:900px){
    .hero-inner{grid-template-columns:1fr;gap:34px;}
    .hjerte-boks{order:-1;}
    .hjerte-boks img{width:min(72%,260px);}
    .nepal-inner{grid-template-columns:1fr;gap:28px;}
    .nepal-bilde{order:-1;}
    .tall-grid{grid-template-columns:1fr;}
  }
</style>
