---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { kr, dato } from '../lib/format';

const prosjekter = (await getCollection('prosjekter')).sort((a, b) => b.data.aar - a.data.aar);
const totalt = prosjekter.reduce((s, p) => s + (p.data.belop ?? 0), 0);
const antall = prosjekter.length;
const utfylte = prosjekter;
// Ett høydepunkt per år – det største beløpet – slik at forsiden viser bredden i arbeidet
const perAar = new Map<number, typeof utfylte[number]>();
for (const p of utfylte) {
  if (!p.data.belop) continue;
  const forrige = perAar.get(p.data.aar);
  if (!forrige || (forrige.data.belop ?? 0) < p.data.belop) perAar.set(p.data.aar, p);
}
const hoydepunkter = [...perAar.values()].sort((a, b) => b.data.aar - a.data.aar).slice(0, 6);

const nyheter = (await getCollection('nyheter'))
  .sort((a, b) => b.data.dato.valueOf() - a.data.dato.valueOf())
  .slice(0, 3);
---
<Base tittel="Heart of Gold">
  <div class="hero">
    <div class="blob b1"></div><div class="blob b2"></div><div class="blob b3"></div>
    <div class="wrap hero-inner">
      <div>
        <span class="merkelapp">Frivillig forening i Eidskog · siden 2001</span>
        <h1>Å gjøre verden bedre for <span class="stripe">noen</span></h1>
        <p class="ingress">Konserter, quizkvelder og dugnad. Alt vi samler inn går rett videre til en hjertesak. Ingen sak er for liten, ingen er for stor.</p>
        <div class="hero-knapper">
          <a class="kn kn-p" href="/stott-oss">Støtt en hjertesak</a>
          <a class="kn kn-s" href="/prosjekter">Se hva vi har gjort</a>
        </div>
      </div>
      <div class="hjerte-boks">
        <svg viewBox="0 0 200 190" role="img" aria-label="Heart of Gold">
          <defs>
            <linearGradient id="hg" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#E8437F"/><stop offset=".35" stop-color="#FF6B4A"/>
              <stop offset=".65" stop-color="#FFC145"/><stop offset="1" stop-color="#1FB39C"/>
            </linearGradient>
            <linearGradient id="hg2" x1="1" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#4B54C8"/><stop offset="1" stop-color="#E8437F"/>
            </linearGradient>
          </defs>
          <path d="M100 178S12 126 12 66C12 32 38 10 66 10c15 0 28 8 34 20 6-12 19-20 34-20 28 0 54 22 54 56 0 60-88 112-88 112z" fill="url(#hg)"/>
          <path d="M100 178S12 126 12 66C12 32 38 10 66 10c15 0 28 8 34 20 6-12 19-20 34-20 28 0 54 22 54 56 0 60-88 112-88 112z" fill="url(#hg2)" opacity=".28"/>
        </svg>
      </div>
    </div>
  </div>

  <div class="tallrad">
    <div class="wrap tall-grid">
      <div class="tallkort"><b>{kr(totalt)}</b><span>gitt bort siden 2001</span></div>
      <div class="tallkort"><b>{antall}</b><span>tiltak gjennomført</span></div>
      <div class="tallkort"><b>100 %</b><span>går til formålet</span></div>
    </div>
  </div>

  <section>
    <div class="wrap">
      <div class="tittelblokk">
        <span class="merkelapp">Om foreningen</span>
        <h2>To formål, ett motto</h2>
      </div>
      <div class="formal">
        <div class="fkort">
          <div class="prikk" style="background:var(--korall)">1</div>
          <h3>Gi videre</h3>
          <p>Støtte gode formål og tiltak, fortrinnsvis med økonomiske bidrag. Inntektene skapes gjennom tiltak og arrangementer, og overskuddet går i sin helhet til veldedige formål.</p>
        </div>
        <div class="fkort">
          <div class="prikk" style="background:var(--indigo)">2</div>
          <h3>Bære minnet</h3>
          <p>Hedre Robert Rønhovdes minne og videreføre hans åndelige arv. Hvert år støtter vi en ny hjertesak i hans navn.</p>
        </div>
      </div>
      <a class="lenke-videre" href="/om-oss">Mer om foreningen og historien →</a>
    </div>
  </section>

  <div class="robert-blokk">
    <div class="robert-inner">
      <div>
        <span class="merkelapp pa-morkt">Robert Rønhovde</span>
        <h2>En gutt med det aller største hjertet</h2>
      </div>
      <div>
        <p class="sitat">«Han dømte aldri noen. Han var glad i alle uansett form, farge eller kjønn.»</p>
        <p>22. juli 2010 mistet vi Robert i en meningsløs og tragisk ulykke, 17 år gammel. I minneordene i kirken sa presten at Robert med sin væremåte gjorde verden til et bedre sted å være.</p>
        <p><a class="gul-lenke" href="/robert">Les hele historien →</a></p>
      </div>
    </div>
  </div>

  <section>
    <div class="wrap">
      <div class="tittelblokk">
        <span class="merkelapp">Prosjekter</span>
        <h2>Hver krone videre</h2>
        <p class="undertekst">Et utvalg av tiltakene siden 2001. Alt vi har samlet inn er gitt videre.</p>
      </div>
      <div class="kortgrid">
        {hoydepunkter.map((p, i) => (
          <a class="pkort" href={`/prosjekter#${p.id}`}>
            <span class={`ar f${i % 5}`}>{p.data.aar}</span>
            <b>{p.data.tittel}</b>
            {p.data.mottaker && <small>{p.data.mottaker}</small>}
            <span class="sum">{kr(p.data.belop)}</span>
          </a>
        ))}
      </div>
      <a class="lenke-videre" href="/prosjekter">Alle prosjekter 2001–i dag →</a>
    </div>
  </section>

  {nyheter.length > 0 && (
    <section class="aktuelt-blokk">
      <div class="wrap">
        <div class="tittelblokk">
          <span class="merkelapp">Aktuelt</span>
          <h2>Det skjer nå</h2>
        </div>
        <div class="kortgrid">
          {nyheter.map(n => (
            <a class="kort" href={`/aktuelt/${n.id}`}>
              <div class="kort-bilde">{n.data.bilde && <img src={n.data.bilde} alt="" loading="lazy" />}</div>
              <div class="kort-tekst">
                <time datetime={n.data.dato.toISOString()}>{dato(n.data.dato)}</time>
                <h3>{n.data.tittel}</h3>
                {n.data.ingress && <p>{n.data.ingress}</p>}
              </div>
            </a>
          ))}
        </div>
        <a class="lenke-videre" href="/aktuelt">Alle nyheter →</a>
      </div>
    </section>
  )}

  <section>
    <div class="wrap">
      <div class="stotte-boks">
        <h2>Bli med å gi</h2>
        <p>Alt vi samler inn går uavkortet videre. Ingen i foreningen tar ut en krone.</p>
        <a class="kn kn-hvit" href="/stott-oss">Slik støtter du oss</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero{position:relative;overflow:hidden;padding:clamp(48px,7vw,78px) 0 clamp(52px,7vw,82px);}
  .blob{position:absolute;border-radius:50%;filter:blur(70px);opacity:.5;pointer-events:none;}
  .b1{width:520px;height:520px;background:var(--magenta);top:-190px;right:-100px;}
  .b2{width:430px;height:430px;background:var(--gul);top:60px;right:180px;opacity:.42;}
  .b3{width:400px;height:400px;background:var(--turkis);top:-120px;right:340px;opacity:.32;}
  .hero-inner{position:relative;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);
    gap:52px;align-items:center;}
  .hero h1{margin-top:18px;}
  .stripe{background:linear-gradient(100deg,var(--magenta),var(--korall) 42%,var(--gul) 70%,var(--turkis));
    -webkit-background-clip:text;background-clip:text;color:transparent;}
  .ingress{font-size:19px;color:var(--blekk-mykt);max-width:46ch;margin-top:22px;}
  .hero-knapper{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px;}
  .hjerte-boks{display:grid;place-items:center;}
  .hjerte-boks svg{width:min(100%,380px);height:auto;}

  .tallrad{padding-bottom:12px;}
  .tall-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;}
  .tallkort{border-radius:var(--radius);padding:28px 26px;color:#fff;}
  .tallkort:nth-child(1){background:linear-gradient(140deg,var(--magenta),var(--korall));}
  .tallkort:nth-child(2){background:linear-gradient(140deg,var(--indigo),#7A6BE8);}
  .tallkort:nth-child(3){background:linear-gradient(140deg,var(--turkis),#3FCF9B);}
  .tallkort b{font-family:var(--display);font-weight:800;font-size:clamp(28px,4.6vw,44px);
    display:block;line-height:1.05;font-variant-numeric:tabular-nums;}
  .tallkort span{display:block;margin-top:9px;font-weight:600;font-size:14.5px;opacity:.93;}

  .formal{display:grid;grid-template-columns:1fr 1fr;gap:20px;}
  .fkort{border:1px solid var(--kant);border-radius:var(--radius);padding:30px;background:#fff;}
  .fkort .prikk{width:38px;height:38px;border-radius:12px;display:grid;place-items:center;
    color:#fff;font-weight:800;font-size:17px;margin-bottom:16px;font-family:var(--display);}
  .fkort h3{margin-bottom:10px;}
  .fkort p{margin:0;color:var(--blekk-mykt);font-size:16px;}

  .robert-blokk{background:var(--blekk);color:#EDEAF6;border-radius:var(--radius-stor);margin:0 24px;}
  .robert-inner{max-width:calc(var(--maks) - 48px);margin:0 auto;padding:clamp(46px,6vw,74px) 34px;
    display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:52px;align-items:center;}
  .robert-blokk h2{color:#fff;margin-top:18px;}
  .robert-blokk p{color:#B7B1CB;}
  .sitat{font-family:var(--display);font-weight:500;font-size:clamp(19px,2.7vw,26px);
    line-height:1.35;color:#fff;border-left:3px solid var(--gul);padding-left:22px;margin:0 0 24px;}
  .gul-lenke{color:var(--gul);font-weight:700;text-decoration:none;border-bottom:2px solid rgba(255,193,69,.4);}

  .aktuelt-blokk{background:var(--tak);}

  .stotte-boks{background:linear-gradient(135deg,var(--magenta),var(--korall) 45%,var(--gul));
    border-radius:var(--radius-stor);padding:clamp(46px,6vw,64px) 30px;color:#fff;text-align:center;}
  .stotte-boks h2{color:#fff;}
  .stotte-boks p{max-width:48ch;margin:16px auto 28px;font-size:18px;color:rgba(255,255,255,.95);}

  @media (max-width:900px){
    .hero-inner{grid-template-columns:1fr;gap:34px;}
    .hjerte-boks{order:-1;}
    .hjerte-boks svg{width:min(72%,260px);}
    .tall-grid{grid-template-columns:1fr;}
    .formal{grid-template-columns:1fr;}
    .robert-inner{grid-template-columns:1fr;gap:28px;}
    .robert-blokk{margin:0 16px;}
  }
</style>
