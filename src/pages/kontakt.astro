---
import Base from '../layouts/Base.astro';
---
<Base tittel="Kontakt" beskrivelse="Ta kontakt med Heart of Gold i Eidskog.">
  <section>
    <div class="wrap">
      <div class="tittelblokk">
        <span class="merkelapp">Kontakt</span>
        <h1>Ta kontakt</h1>
        <p class="undertekst">Har du en sak du mener vi bør støtte, vil bidra på et arrangement, eller bare lurer på noe? Vi hører gjerne fra deg.</p>
      </div>

      <div class="epostboks">
        <p class="etikett">E-post</p>
        <p class="epost"><a href="mailto:heart.of.gold.eidskog@gmail.com">heart.of.gold.eidskog@gmail.com</a></p>
      </div>

      <div class="personer">
        <div class="person">
          <h3>Siv Berg Rønhovde</h3>
          <p class="rolle">Sykepleier ved Kongsvinger DPS</p>
          <p><a href="tel:+4741339911">413 39 911</a></p>
        </div>
        <div class="person">
          <h3>Bjørn Olav Rønhovde</h3>
          <p class="rolle">Glassblåser ved Magnor Glassverk og musiker</p>
          <p><a href="tel:+4741330162">413 30 162</a></p>
        </div>
      </div>

      <p class="fb">Vi legger også ut det meste på <a href="https://www.facebook.com/heartofgoldeidskog/" rel="noopener">Facebook-siden vår</a>.</p>
    </div>
  </section>
</Base>

<style>
  .epostboks{border-radius:var(--radius-stor);padding:clamp(30px,5vw,44px);
    background:linear-gradient(135deg,var(--magenta),var(--korall) 50%,var(--gul));color:#fff;margin-bottom:26px;}
  .etikett{font-size:12.5px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;opacity:.9;margin-bottom:8px;}
  .epost{font-family:var(--display);font-weight:800;font-size:clamp(20px,3.4vw,34px);word-break:break-word;margin:0;}
  .epost a{color:#fff;text-decoration:none;border-bottom:2px solid rgba(255,255,255,.5);}
  .personer{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;}
  .person{border:1px solid var(--kant);border-radius:var(--radius);padding:26px;}
  .person h3{margin-bottom:8px;}
  .rolle{color:var(--blekk-mykt);font-size:15.5px;}
  .person a{color:var(--indigo);font-weight:700;text-decoration:none;}
  .fb{margin-top:30px;color:var(--blekk-mykt);}
  .fb a{color:var(--indigo);}
</style>
