---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { frontmatter, compiledContent } from '../content/sider/om-oss.md';

// Rundet ned til nærmeste hundretusen, så «over» alltid stemmer og teksten
// ikke blir foreldet neste gang et beløp legges inn.
const prosjekter = await getCollection('prosjekter');
const totalt = prosjekter.reduce((s, p) => s + (p.data.belop ?? 0), 0);
const rundet = (Math.floor(totalt / 100000) * 100000).toLocaleString('nb-NO');

// Brødteksten redigeres i CMS-et under «Faste sider». {{totalt}} byttes ut her,
// slik at beløpet alltid regnes ut fra prosjektene. Skrev redaktøren tallet inn
// for hånd, ville det blitt stående og gått ut på dato.
const innhold = (await compiledContent()).replaceAll('{{totalt}}', rundet);
---
<Base tittel="Om oss" beskrivelse="Heart of Gold er en frivillig forening i Eidskog. Her er historien, formålet og menneskene bak.">
  <section>
    <div class="wrap">
      <div class="tittelblokk">
        <span class="merkelapp">{frontmatter.merkelapp}</span>
        <h1>{frontmatter.tittel}</h1>
        <p class="undertekst">{frontmatter.undertekst}</p>
      </div>
      <div class="artikkel">
        {frontmatter.bilde && (
          <figure class="toppbilde">
            <img src={frontmatter.bilde} alt={frontmatter.bildetekst ?? ''} />
          </figure>
        )}
        <Fragment set:html={innhold} />
      </div>
      <a class="lenke-videre" href="/prosjekter">Se alle prosjekter →</a>
    </div>
  </section>
</Base>

<style>
  .toppbilde{margin:0 0 30px;}
  .toppbilde img{width:100%;border-radius:var(--radius);max-height:440px;object-fit:cover;}
</style>
