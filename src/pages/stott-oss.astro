---
import Base from '../layouts/Base.astro';
// Vipps-nummeret er hentet fra foreningens eget Facebook-innlegg 15.06.2019.
const vipps = '#86319';
const kontonummer = null;
const orgnr = null;
---
<Base tittel="Støtt oss" beskrivelse="Slik kan du støtte Heart of Gold. Alt vi samler inn går uavkortet videre til en hjertesak.">
  <section>
    <div class="wrap">
      <div class="tittelblokk">
        <span class="merkelapp">Støtt oss</span>
        <h1>Bli med å gi</h1>
        <p class="undertekst">Alt vi samler inn går uavkortet videre. Ingen i foreningen tar ut en krone.</p>
      </div>

      <div class="maater">
        <div class="maate">
          <h3>Vipps</h3>
          {vipps
            ? <p class="stort">{vipps}</p>
            : <p class="mangler">Vipps-nummer legges inn her.</p>}
          <p>Søk opp <strong>Heart of Gold</strong> i Vipps, eller bruk nummeret over. Skriv gjerne hva bidraget gjelder i meldingsfeltet.</p>
        </div>
        <div class="maate">
          <h3>Bankkonto</h3>
          {kontonummer
            ? <p class="stort">{kontonummer}</p>
            : <p class="mangler">Kontonummer legges inn her.</p>}
          <p>Passer for større bidrag og for bedrifter.</p>
        </div>
        <div class="maate">
          <h3>Bli med på et arrangement</h3>
          <p>Kom på konsert eller quizkveld. Billettinntektene er selve grunnlaget for det vi gir bort.</p>
          <a class="lenke-videre" href="/aktuelt">Se hva som skjer →</a>
        </div>
      </div>

      <div class="tillit">
        <h2>Hva skjer med pengene</h2>
        <p>Heart of Gold støtter én hjertesak hvert år. Det er Bjørn Olav Rønhovde og Siv Monica Berg som bestemmer hvilket tiltak som skal støttes, i tråd med foreningens vedtekter. Overskuddet fra all virksomhet går i sin helhet til veldedige formål, og medlemmene kan etter vedtektene ikke motta økonomiske bidrag fra foreningen.</p>
        <p>Alt vi har gitt bort siden 2001 er dokumentert år for år.</p>
        <a class="lenke-videre" href="/prosjekter">Se hele oversikten →</a>
        {orgnr && <p class="orgnr">Organisasjonsnummer: {orgnr}</p>}
      </div>
    </div>
  </section>
</Base>

<style>
  .maater{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;}
  .maate{border:1px solid var(--kant);border-radius:var(--radius);padding:28px;background:#fff;}
  .maate h3{margin-bottom:12px;}
  .maate p{color:var(--blekk-mykt);font-size:15.5px;}
  .stort{font-family:var(--display);font-weight:800;font-size:34px;color:var(--blekk);
    font-variant-numeric:tabular-nums;margin-bottom:12px;}
  .mangler{font-family:var(--display);font-weight:700;font-size:17px;color:#7A5600;
    background:rgba(255,193,69,.22);border-radius:12px;padding:12px 16px;margin-bottom:12px;}
  .tillit{margin-top:44px;border-radius:var(--radius-stor);background:var(--tak);padding:clamp(32px,5vw,48px);}
  .tillit h2{margin-bottom:16px;}
  .tillit p{color:var(--blekk-mykt);max-width:66ch;}
  .orgnr{margin-top:20px;font-size:14px;}
</style>
